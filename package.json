{
  "name": "hindsight",
  "version": "0.1.0",
  "description": "Reads IBM Bob session exports, finds context waste, generates corrected config, and proves the improvement.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev":        "tsx src/cli.ts",
    "dev:web":    "vite",
    "build":      "tsup src/cli.ts --format cjs --dts --clean",
    "build:web":  "vite build",
    "preview":    "vite preview",
    "test":       "vitest run",
    "test:watch": "vitest",
    "test:cov":   "vitest run --coverage",
    "demo":       "npm run build && node dist/cli.js --input fixtures/sample-export.json --demo",
    "typecheck":  "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^24.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^1.6.1"
  }
}
